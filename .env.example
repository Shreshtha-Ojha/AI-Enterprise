# Copy this file to .env and fill in real values for local development.
# .env is gitignored and must never be committed.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to make cross-origin requests (the Vite dev server, by default)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL) ---
DB_NAME=enterprise_ai_platform
DB_USER=enterprise_ai_platform
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- RAG pipeline ---
# Required to use POST /api/query — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (sensible defaults are used if unset):
# ANTHROPIC_MODEL=claude-opus-5
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=5
# RAG_VECTOR_STORE_DIR=./data/vector_store
