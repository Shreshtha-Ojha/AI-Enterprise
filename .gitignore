# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Poetry ---
# poetry.lock IS committed (reproducible installs); nothing poetry-specific to ignore beyond venvs above.

# --- Django ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-3
media/
staticfiles/

# Django migrations noise (keep real migrations once apps exist; ignore accidental
# machine-generated cache/backup files, not the migrations/ dirs themselves)
**/migrations/__pycache__/
*.migrations_backup

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Testing / coverage ---
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/

# --- Type checking / linting caches ---
.mypy_cache/
.ruff_cache/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Docker ---
postgres_data/

# --- RAG local vector store (FAISS index + sidecar metadata) ---
data/vector_store/*
!data/vector_store/.gitkeep
